{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "tap",
  "tap": {
    "testFiles": ["src/lib/*.test.ts"],
    "nodeArgs": ["--experimental-strip-types"],
    "forceBail": true
  },
  "mutate": [
    "src/lib/answerFallback.ts",
    "src/lib/documentIdentity.ts",
    "src/lib/historyQuestionGrader.ts",
    "src/lib/masteryAnalytics.ts",
    "src/lib/numericUnits.ts",
    "src/lib/quizAttempt.ts",
    "src/lib/quizGenerationPolicy.ts",
    "src/lib/quizHistoryAnalytics.ts",
    "src/lib/quizHistoryPagination.ts",
    "src/lib/shortAnswerGrader.ts",
    "src/lib/weakAreaAnalytics.ts"
  ],
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": {
    "fileName": "reports/mutation.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation.json"
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  }
}
